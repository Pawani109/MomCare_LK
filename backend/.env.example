# ---- MySQL database (momcare) ----
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=your_db_password_here
DB_NAME=momcare
# Optional: pool size (default 10)
DB_POOL_LIMIT=10

# JWT signing secret (set a long random value in production)
JWT_SECRET=momcare-lk-demo-secret

TEXTLK_API_TOKEN=your_token_here
TEXTLK_SENDER_ID=MomCareLK

# Google Places API (New) web-service key. Restrict this key to Places API.
GOOGLE_MAPS_API_KEY=

# EmailJS - Forgot-password OTP email
# Get these values from your EmailJS dashboard.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Optional: only if your EmailJS setup requires a private/access token.
EMAILJS_PRIVATE_KEY=
